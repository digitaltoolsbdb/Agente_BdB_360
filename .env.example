# Pendiente confirmar con lineamientos internos: <<URL_HTTPS_APROBADA>>.
# No reutilizar la comilla final (%22) del curl original.
CONSULTA_PRODUCTOS_SOAP_URL=
CONSULTA_PRODUCTOS_TIMEOUT_SECONDS=30

# Opcional: bundle PEM de CA corporativas aprobado para httpx.
# SSL_CERT_FILE=/ruta/aprobada/ca-bundle.pem

# Servidor MCP
MCP_SERVER_NAME=BDB Transaccionador v4 MCP
# Hosts adicionales separados por coma (se suman a los predeterminados).
MCP_ALLOWED_HOSTS=

# Transaccionador v4 (txdor_tranzar). Si se omiten URL, oficina o IP se usan
# los valores previos del codigo. Transporte HTTP pendiente confirmar con
# Seguridad/Arquitectura.
TXDOR_SOAP_URL=http://10.0.0.7:8400/TransaccionadorV4/TxdorServicePort
TXDOR_OFFICE=025
TXDOR_CLIENT_IP=10.86.124.1
TXDOR_TIMEOUT_SECONDS=30
# Obligatorias. Si se clasifican como credenciales, inyectarlas desde el
# gestor de secretos aprobado; no versionar valores reales.
TXDOR_USER=<<VALOR_APROBADO>>
TXDOR_IDENTIFICATION=<<VALOR_APROBADO>>
