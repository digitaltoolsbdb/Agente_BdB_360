# VARIABLES (ajusta a tu entorno)
ACR_NAME=aqadacrmcponbasepr
IMAGE_NAME=mcp-onbase
APP_NAME=aqad-app-mcp-onbase-pr
RG=Bdb-PR-RG-AQAD-FQ-AGENT-IAC
ENV_NAME=

# 1️⃣ Login
az acr login --name $ACR_NAME

# 2️⃣ Build de la imagen en ACR (sin Docker local)
az acr build \
  --registry $ACR_NAME \
  --image $IMAGE_NAME:$TAG \
  .

# 3️⃣ Actualizar Container App con la nueva imagen
az containerapp update \
  --name $APP_NAME \
  --resource-group $RG \
  --image $ACR_NAME.azurecr.io/$IMAGE_NAME:$TAG

# 4️⃣ Ver revisiones (opcional)
az containerapp revision list \
  --name $APP_NAME \
  --resource-group $RG \
  --output table

  version 2

  TAG=25082026v1 \

az acr build \
  --registry $ACR_NAME \
  --image $IMAGE_NAME:$TAG \
  .
  sleep 60

az containerapp update \
  --name $APP_NAME \
  --resource-group $RG \
  --image $ACR_NAME.azurecr.io/$IMAGE_NAME:$TAG


az containerapp show \
  --name $APP_NAME \
  --resource-group $RG \
  --query "properties.template.containers[0].image"

  #revision extra:

  # 4) Esperar un momento y revisar las revisiones
az containerapp revision list \
  --name "$APP_NAME" \
  --resource-group "$RG" \
  --query "[].{revision:name, active:properties.active, runningState:properties.runningState, healthState:properties.healthState, replicas:properties.replicas, image:properties.template.containers[0].image}" \
  -o table
